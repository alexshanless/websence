# Formspree / Getform / Web3Forms endpoint. Submissions go to email and stay in that dashboard.
VITE_CONTACT_FORM_ENDPOINT=

# GA4 measurement ID, e.g. G-XXXXXXXX
VITE_GA4_MEASUREMENT_ID=

# Quote form backend (Netlify function). All optional:
# without them the submission is still stored in Netlify Blobs, it just is
# not emailed. Set these in Netlify, not here.
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
